# .gitignore for the FED Watcher project

# --- Environments ---
# Ignore virtual environment folders.
/finbert_env/
/venv/
/.venv/
/.conda/

# --- Data & Models ---
# Ignore all data directories. Data does not belong in Git.
/data/

# Ignore common data file extensions, regardless of location.
*.csv
*.xlsx
*.json
*.parquet

# Ignore serialized model files.
*.pkl
*.pickle
*.joblib
*.h5

# --- Python ---
# Ignore Python cache files and compiled files.
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore distribution/build artifacts.
/build/
/dist/
*.egg-info/
*.egg

# --- Jupyter Notebooks ---
# Ignore notebook checkpoints and other runtime files.
.ipynb_checkpoints/
.pytest_cache/

# --- IDE / Editor Configuration ---
# Ignore configuration files from popular editors.
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Sensitive Information ---
# Ignore environment files that may contain API keys or secrets.
.env
*.env

# --- Logs ---
# Ignore log files and directories.
*.log
logs/

# --- OS-specific files ---
# Ignore files generated by macOS, Windows, and Linux.
.DS_Store
Thumbs.db
desktop.ini